---
import { metricKeys, plotModel, variantNames, type CaseData } from './results-plot';
interface Props { caseData: CaseData; locale?: 'zh' | 'en'; xLabel?: string; defaultLog?: boolean }
const { caseData, locale = 'zh', xLabel, defaultLog = false } = Astro.props;
const en = locale === 'en';
const ui = en ? {
  kind: 'Measured', metric: 'Metric', variant: 'Variant', all: 'All variants', log: 'Log y-axis',
  x: 'Step', index: 'Measurement', empty: 'No measured curves available yet.',
  caption: 'One line per seed; color identifies the variant. Dots are recorded measurements, joined by straight lines. Missing values remain gaps. No smoothing or fitted trend is shown.',
  nojs: 'JavaScript is off: the initial measured curve is shown.',
} : {
  kind: '实测', metric: '指标', variant: '实验条件', all: '全部条件', log: '纵轴对数刻度',
  x: '训练步数', index: '记录序号', empty: '尚无可展示的实测曲线。',
  caption: '每条线对应一个 seed，同色表示同一实验条件。点是记录下来的测量，之间用直线连接；缺失值保留为空缺。没有平滑或拟合趋势线。',
  nojs: 'JavaScript 未开启：当前展示默认的实测曲线。',
};
const metrics = metricKeys(caseData);
const metric = metrics[0] ?? '';
const model = plotModel(caseData, metric, '', defaultLog);
const names = variantNames(caseData);
const resolvedXLabel = xLabel ?? (model.hasSteps ? ui.x : ui.index);
const plotTitle = `${caseData.title}: ${metric}${model.log ? ' (log)' : ''}`;
const summary = en ? `${model.lines.filter(line => line.dots.length).length} runs · ${model.pointCount} measurements${model.log ? ' · log y-axis' : ''}` : `${model.lines.filter(line => line.dots.length).length} 次运行 · ${model.pointCount} 个测量点${model.log ? ' · 纵轴对数刻度' : ''}`;
---

<figure class="results-plot" data-results-plot data-case={JSON.stringify(caseData)} data-locale={locale} data-x-label={resolvedXLabel}>
  <div class="plot-controls">
    <label>{ui.metric}<select data-plot-metric disabled>{metrics.map(key => <option value={key}>{key}</option>)}</select></label>
    <label>{ui.variant}<select data-plot-variant disabled><option value="">{ui.all}</option>{names.map(name => <option value={name}>{name}</option>)}</select></label>
    <label class="log-label"><input type="checkbox" data-plot-log checked={model.log} disabled />{ui.log}</label>
  </div>
  <div class="chart-stage" hidden={!model.pointCount} data-chart-stage>
    <svg class="chart" viewBox="0 0 680 288" role="img" aria-label={plotTitle} data-chart>
      <title data-chart-title>{plotTitle}</title>
      <g data-y-ticks>{model.yTicks.map(tick => <g><line x1="62" x2="660" y1={tick.at} y2={tick.at} stroke="#d4dbdf" stroke-width="0.7" /><text x="53" y={tick.at + 4} text-anchor="end" fill="#606b74" font-size="11">{tick.label}</text></g>)}</g>
      <g data-x-ticks>{model.xTicks.map(tick => <text x={tick.at} y="264" text-anchor="middle" fill="#606b74" font-size="11">{tick.label}</text>)}</g>
      <g data-series>{model.lines.map(line => <g><path d={line.path} fill="none" stroke={line.color} stroke-width="1.3" opacity="0.68"><title>{line.name} · seed {line.seed}</title></path>{line.dots.map(point => <circle cx={point.x} cy={point.y} r="1.7" fill={line.color} opacity="0.78"><title>{line.name} · seed {line.seed} · {resolvedXLabel} {point.step}: {point.value}</title></circle>)}</g>)}</g>
      <text x="360" y="285" text-anchor="middle" fill="#606b74" font-size="11" data-x-label>{resolvedXLabel}</text>
    </svg>
    <div class="plot-legend" data-plot-legend>{model.legend.map(item => <span><i style={`background:${item.color}`} aria-hidden="true"></i><span>{item.name}<small>seed {item.seeds.join(', ')}</small></span></span>)}</div>
  </div>
  <p class="empty-message" data-empty hidden={!!model.pointCount}>{ui.empty}</p>
  <p class="plot-status" data-plot-status role="status" aria-live="polite" aria-atomic="true">{summary}</p>
  <figcaption><span class="figure-title">{caseData.title}.</span> {ui.caption}</figcaption>
  <noscript><p class="no-script">{ui.nojs}</p></noscript>
</figure>

<script>
  import { plotModel, type CaseData } from './results-plot';
  document.querySelectorAll<HTMLElement>('[data-results-plot]').forEach(root => {
    const data = JSON.parse(root.dataset.case!) as CaseData;
    const en = root.dataset.locale === 'en';
    const xLabel = root.dataset.xLabel!;
    const metric = root.querySelector<HTMLSelectElement>('[data-plot-metric]')!;
    const variant = root.querySelector<HTMLSelectElement>('[data-plot-variant]')!;
    const log = root.querySelector<HTMLInputElement>('[data-plot-log]')!;
    const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
    const make = <K extends keyof SVGElementTagNameMap>(tag: K, attributes: Record<string, string | number>, value?: string) => {
      const element = document.createElementNS('http://www.w3.org/2000/svg', tag);
      Object.entries(attributes).forEach(([key, value]) => element.setAttribute(key, String(value)));
      if (value !== undefined) element.textContent = value;
      return element;
    };
    const render = () => {
      const model = plotModel(data, metric.value, variant.value, log.checked);
      log.disabled = !model.logAllowed;
      log.checked = model.log;
      root.querySelector<HTMLElement>('[data-chart-stage]')!.hidden = !model.pointCount;
      root.querySelector<HTMLElement>('[data-empty]')!.hidden = !!model.pointCount;
      const title = `${data.title}: ${metric.value}${model.log ? ' (log)' : ''}`;
      svg.setAttribute('aria-label', title);
      svg.querySelector('[data-chart-title]')!.textContent = title;
      svg.querySelector('[data-x-label]')!.textContent = xLabel;
      svg.querySelector('[data-y-ticks]')!.replaceChildren(...model.yTicks.map(tick => {
        const group = make('g', {});
        group.append(make('line', { x1: 62, x2: 660, y1: tick.at, y2: tick.at, stroke: '#d4dbdf', 'stroke-width': 0.7 }), make('text', { x: 53, y: tick.at + 4, 'text-anchor': 'end', fill: '#606b74', 'font-size': 11 }, tick.label));
        return group;
      }));
      svg.querySelector('[data-x-ticks]')!.replaceChildren(...model.xTicks.map(tick => make('text', { x: tick.at, y: 264, 'text-anchor': 'middle', fill: '#606b74', 'font-size': 11 }, tick.label)));
      svg.querySelector('[data-series]')!.replaceChildren(...model.lines.map(line => {
        const group = make('g', {});
        const path = make('path', { d: line.path, fill: 'none', stroke: line.color, 'stroke-width': 1.3, opacity: 0.68 });
        path.append(make('title', {}, `${line.name} · seed ${line.seed}`));
        group.append(path);
        line.dots.forEach(point => {
          const dot = make('circle', { cx: point.x, cy: point.y, r: 1.7, fill: line.color, opacity: 0.78 });
          dot.append(make('title', {}, `${line.name} · seed ${line.seed} · ${xLabel} ${point.step}: ${point.value}`));
          group.append(dot);
        });
        return group;
      }));
      root.querySelector('[data-plot-legend]')!.replaceChildren(...model.legend.map(item => {
        const entry = document.createElement('span');
        const swatch = document.createElement('i');
        swatch.style.background = item.color;
        swatch.setAttribute('aria-hidden', 'true');
        const name = document.createElement('span');
        name.textContent = item.name;
        const seeds = document.createElement('small');
        seeds.textContent = `seed ${item.seeds.join(', ')}`;
        name.append(seeds);
        entry.append(swatch, name);
        return entry;
      }));
      const runs = model.lines.filter(line => line.dots.length).length;
      root.querySelector('[data-plot-status]')!.textContent = en ? `${runs} runs · ${model.pointCount} measurements${model.log ? ' · log y-axis' : ''}` : `${runs} 次运行 · ${model.pointCount} 个测量点${model.log ? ' · 纵轴对数刻度' : ''}`;
    };
    metric.disabled = metric.options.length < 2;
    variant.disabled = variant.options.length < 3;
    [metric, variant, log].forEach(control => control.addEventListener('change', render));
    render();
  });
</script>

<style>
  .results-plot{--rp-ink:#262927;--rp-blue:#385b95;--rp-line:#d4dbdf;--rp-muted:#606b74;margin:32px 0;padding:24px;border:1px solid var(--rp-line);border-radius:6px;background:#f8f9fa;color:var(--rp-ink);font:inherit;line-height:1.6}.plot-heading{display:grid;gap:7px}.kind{font-size:11px;color:var(--rp-blue);letter-spacing:.025em}.plot-title{font-size:17px;font-weight:600;line-height:1.5}.plot-controls{display:flex;flex-wrap:wrap;gap:12px 16px;align-items:flex-end;margin:20px 0 14px}.plot-controls label{display:flex;flex-direction:column;gap:5px;min-width:0;max-width:100%;font-size:11px;color:var(--rp-muted)}.plot-controls select{max-width:230px;width:100%;min-height:40px;padding:7px 28px 7px 9px;border:1px solid var(--rp-line);border-radius:4px;background:#f1f3f4;color:var(--rp-ink);font:inherit;font-size:12px}.plot-controls .log-label{flex-direction:row;align-items:center;min-height:40px;gap:6px}.log-label input{accent-color:var(--rp-blue);width:15px;height:15px}.plot-controls select:focus-visible,.plot-controls input:focus-visible{outline:2px solid var(--rp-blue);outline-offset:3px}.plot-controls select:disabled{opacity:.7}.chart{display:block;width:100%;height:auto;font-family:'DM Sans',-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC',sans-serif;overflow:visible}.chart-stage[hidden],.empty-message[hidden]{display:none}.plot-legend{display:flex;flex-wrap:wrap;gap:12px 20px;margin:12px 0;font-size:11px;line-height:1.5}.plot-legend :global(>span){display:flex;align-items:flex-start;gap:7px;min-width:0;overflow-wrap:anywhere}.plot-legend :global(i){display:block;width:14px;height:2px;flex-shrink:0;margin-top:7px}.plot-legend :global(small){display:block;font-size:10px;color:var(--rp-muted)}.results-plot .plot-status{margin:14px 0 0;font-size:11px;color:var(--rp-muted)}.results-plot figcaption{font-size:12px;color:var(--rp-muted);margin:12px 0 0;line-height:1.75}.results-plot .empty-message{padding:32px 0;text-align:center;color:var(--rp-muted);font-size:13px}.no-script{font-size:12px;color:var(--rp-muted)}
  @media(max-width:560px){.results-plot{padding:18px 14px}.plot-title{font-size:16px}.plot-controls{gap:10px}.plot-controls label{flex:1 1 120px}.plot-controls .log-label{flex:1 1 100%}.chart{min-width:460px}.chart-stage{overflow-x:auto;scrollbar-width:thin}.plot-legend{max-width:100%;padding-bottom:5px}}
</style>
