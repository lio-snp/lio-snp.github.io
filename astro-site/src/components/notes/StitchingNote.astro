---
import Favicons from '../Favicons.astro';
import Analytics from '../Analytics.astro';
import TensorMapping from './stitching/TensorMapping.astro';
import FusionOrder from './stitching/FusionOrder.astro';
import ResultsPlot from './stitching/ResultsPlot.astro';
import report from '../../data/notes/module-stitching.json';
import '../../styles/notes.css';
import '../../styles/stitching-note.css';

interface Props { locale?: 'zh' | 'en'; preview?: boolean }
const { locale = 'en', preview = false } = Astro.props;
const en = locale === 'en';
const t = (pair: {zh: string; en: string}) => pair[locale];
const canonicalBase = '/notes/module-stitching/';
const base = preview ? '/demos/notes/module-stitching/' : canonicalBase;
const englishUrl = preview ? `${base}en/` : base;
const chineseUrl = preview ? base : `${base}zh/`;
const title = en ? 'The modules fit. Why didn’t the model improve?' : '模块接上了，为什么没变好？';
const toc = [{id:'setup', title: en ? 'Setup' : '实验设置'}, ...report.sections.map(s => ({id:s.id,title:t(s.title)})), {id:'takeaways',title:en ? 'Scope' : '适用范围'}];
type HeaderGroup = { label: string; columns?: string[] };
const tableHeaders: Record<string, HeaderGroup[]> = {
  objectives: [
    { label: en ? 'Condition' : '条件' },
    { label: en ? 'Test MSE ↓' : '测试 MSE ↓', columns: en ? ['Main task', 'Auxiliary task'] : ['主任务', '辅助任务'] },
  ],
  capacity: [
    { label: en ? 'Condition' : '条件' },
    { label: en ? 'Parameters' : '参数量' },
    { label: en ? 'Training · noisy labels' : '训练 · 含错标', columns: en ? ['Accuracy ↑'] : ['准确率 ↑'] },
    { label: en ? 'Evaluation · clean labels' : '测试 · 干净标签', columns: en ? ['Accuracy ↑', 'Cross-entropy ↓'] : ['准确率 ↑', 'Cross-entropy ↓'] },
  ],
  gradient: [
    { label: en ? 'Condition' : '条件' },
    { label: en ? 'At initialization' : '初始化时', columns: ['RMS(∂L/∂h₀)'] },
    { label: en ? 'After training' : '训练后', columns: en ? ['Test MSE ↓'] : ['测试 MSE ↓'] },
  ],
};
const rowGroups: Record<string, Record<number, string>> = {
  objectives: { 0: en ? 'Objective-weight sweep · width 1' : '辅助目标权重对照 · 一维瓶颈', 4: en ? 'Interventions at λ = 4' : 'λ = 4 下的干预' },
  capacity: { 0: en ? '100 training images' : '100 张训练图像', 3: en ? '500 training images · larger data budget' : '500 张训练图像 · 更多训练数据' },
  gradient: { 0: en ? 'Shallow reference' : '浅层参考', 1: en ? '20-layer comparisons' : '20 层对照' },
};
// Emphasis follows the contrasts discussed in the text, rather than a global ranking.
const focalCells: Record<string, string[]> = {
  shape: ['1:1', '2:1'], objectives: ['3:1', '3:2', '5:1', '5:2'],
  capacity: ['1:3', '1:4', '2:4'], gradient: ['1:2', '2:2'], fusion: ['0:1', '1:1'],
};
const numericColumn = (id: string, column: number) => column > 0 && (id !== 'scale' || column === 2);
const valueParts = (value: string) => {
  const match = value.match(/^(.*?)\s+(\[[^\]]+\])$/);
  return match ? { main: match[1], range: match[2] } : { main: value, range: '' };
};
---
<!doctype html>
<html lang={en ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {preview && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(en ? canonicalBase : `${canonicalBase}zh/`, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(canonicalBase, Astro.site)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(`${canonicalBase}zh/`, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(canonicalBase, Astro.site)} />
    <meta name="description" content={en ? 'Six small experiments on what can go wrong when combining neural network modules.' : '六组小实验：张量语义、辅助目标、更新尺度、容量、梯度和融合顺序。'} />
    <title>{title} · Yanlin Liu</title>
    <Favicons />
    {!preview && <Analytics />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body id="top" class="stitching-note">
    <a class="skip-link" href="#article">{en ? 'Skip to article' : '跳至正文'}</a>
    <div class="note-shell stitching-shell">
      <header class="note-header">
        <a class="wordmark" href="/">Yanlin Liu<span aria-hidden="true">.</span></a>
        <div class="header-actions">
          <nav aria-label={en ? 'Site navigation' : '网站导航'}><a href="/#about">About</a><a href="/#featured">Research</a><a href="/#notes">Notes</a></nav>
          <nav class="language-switch" aria-label={en ? 'Language' : '语言'}>
            <a data-language-link href={chineseUrl} aria-current={!en ? 'page' : undefined} lang="zh-CN">中文</a><span>/</span>
            <a data-language-link href={englishUrl} aria-current={en ? 'page' : undefined} lang="en">EN</a>
          </nav>
        </div>
      </header>
      <main class="reading-layout">
        <article id="article">
          <header class="article-header prose">
            <div class="eyebrow"><span>Notes</span>{preview && <span class="demo-label">{en ? 'Draft' : '草稿'}</span>}</div>
            <h1>{title}</h1>
            <div class="article-meta"><span>Yanlin Liu</span><time datetime="2026-10-13">{en ? '13 Oct 2026' : '2026 年 10 月 13 日'}</time><span>{en ? 'Experiment notes' : '实验笔记'}</span></div>
            <p class="intro">{en ? 'Combining modules changes more than the architecture: interfaces carry coordinate conventions, objectives compete for shared representations, and output scales affect optimization. Six small controlled experiments examine these changes and the conditions under which proposed fixes help.' : '组合模块会同时改变接口的坐标约定、共享表示承载的信息和优化过程中的更新尺度。下面用六组小型对照实验，分别检查这些变化，以及常见补救设置在什么条件下有效。'}</p>
          </header>
          <nav class="section-index prose" aria-label={en ? 'Article sections' : '文章目录'}>{toc.map(s => <a href={`#${s.id}`}>{s.title}</a>)}</nav>
          <div class="note-body">
            <h2 id="setup">{en ? 'Setup' : '实验设置'}</h2>
            <p>{en ? 'Small models and tasks make individual changes easier to isolate. Five cases use synthetic data; the capacity case uses handwritten digits. Each condition runs with seeds 17, 29, and 43, with shared data and initialization where the architecture permits.' : '小模型与简单任务便于隔离单项变化。五组使用合成数据，容量实验使用手写数字。每个配置运行种子 17、29、43；结构允许时，对照共享数据与初始化。'}</p>
            <p>{en ? `The experiments ran on ${report.hardware}. Tables show the mean and minimum–maximum range across the three seeds; bold values highlight contrasts discussed in the text. Curves show recorded measurements; the two interactive diagrams trace tensor entries and calculate sequence relationships directly.` : `实验在 ${report.hardware} 上运行。表格给出三个种子的均值与最小—最大值，粗体标出正文讨论的对照值；曲线展示实测记录。两块交互图分别用来追踪张量元素、直接计算序列关系。`}</p>
            <p class="lede"><strong>TL;DR</strong> {t(report.tldr)}</p>
            {report.sections.map(section => <section aria-labelledby={section.id}>
              <h2 id={section.id}>{t(section.title)}</h2>
              <p set:html={t(section.setup)} />
              {section.id === 'shape' && <TensorMapping locale={locale} />}
              {section.id === 'fusion' && <FusionOrder locale={locale} />}
              <div class="table-scroll" role="region" tabindex="0" aria-label={`${t(section.title)} ${en ? 'results' : '实验结果'}`}>
                <table class="research-table">
                  {tableHeaders[section.id]?.map(group => <colgroup span={group.columns?.length ?? 1}></colgroup>)}
                  <thead>
                    {tableHeaders[section.id] ? <>
                      <tr>{tableHeaders[section.id].map(group => <th scope={group.columns ? 'colgroup' : 'col'} rowspan={group.columns ? undefined : 2} colspan={group.columns?.length} class={group.columns ? 'column-group' : undefined}>{group.label}</th>)}</tr>
                      <tr>{tableHeaders[section.id].flatMap(group => group.columns ?? []).map(label => <th scope="col" class="metric-cell">{label.replace(/ ([↑↓])/g, '\u00a0$1')}</th>)}</tr>
                    </> : <tr>{section.columns.map((column, index) => <th scope="col" class={numericColumn(section.id, index) ? 'metric-cell' : undefined}>{t(column)}</th>)}</tr>}
                  </thead><tbody>
                  {section.rows.map((row, rowIndex) => <>
                    {rowGroups[section.id]?.[rowIndex] && <tr class="row-group"><td colspan={section.columns.length}>{rowGroups[section.id][rowIndex]}</td></tr>}
                    <tr>{row.map((cell, columnIndex) => {
                      const value = typeof cell === 'string' ? cell : t(cell);
                      const parts = valueParts(value);
                      const focal = focalCells[section.id]?.includes(`${rowIndex}:${columnIndex}`);
                      return columnIndex === 0 ? <th scope="row">{value}</th> : <td class={numericColumn(section.id, columnIndex) ? 'metric-cell' : 'status-cell'}>
                        {focal ? <strong class="metric-value">{parts.main}</strong> : <span class="metric-value">{parts.main}</span>}
                        {parts.range && <span class="metric-detail">{parts.range}</span>}
                      </td>;
                    })}</tr>
                  </>)}
                </tbody></table>
              </div>
              <p set:html={t(section.observation)} />
              {'gradientResults' in section && section.gradientResults && <ResultsPlot caseData={section.gradientResults} locale={locale} xLabel={en ? 'Layer position' : '层位置'} defaultLog />}
              <ResultsPlot caseData={section.results} locale={locale} defaultLog={section.id === 'scale'} />
              <p set:html={t(section.takeaway)} />
            </section>)}
            <h2 id="takeaways">{en ? 'Scope' : '适用范围'}</h2>
            <p>{en ? 'These short runs isolate specific effects rather than compare general-purpose architectures. Their interpretation depends on the constructed data, initialization, optimizer, and training budget. In particular, the scale result concerns SGD, the capacity experiment combines two regularizers, and the fusion variants use different amounts of computation. These conditions limit which conclusions transfer to a larger project.' : '这些短训练用于隔离具体效应，并非通用架构的性能比较。结果依赖于构造数据、初始化、优化器与训练预算。其中，尺度实验针对 SGD，容量实验同时使用两种正则，融合版本的计算量不同。这些条件决定了哪些结论可以迁移到更大的项目。'}</p>
            <h3>{en ? 'Reading that informed the checks' : '相关阅读'}</h3>
            <ul class="references">
              <li><a href="https://xhslink.cn/o/Adte32LztK4">{en ? 'The six-point post that prompted this note' : '最初看到的六条经验帖'}</a></li>
              <li><a href="https://docs.pytorch.org/docs/stable/generated/torch.reshape.html">PyTorch: reshape</a> / <a href="https://docs.pytorch.org/docs/stable/notes/broadcasting.html">broadcasting</a>{en ? ' — tensor shape operations.' : '——张量形状操作。'}</li>
              <li><a href="https://arxiv.org/abs/2001.06782">Gradient Surgery for Multi-Task Learning</a>{en ? ' — background on interactions between task gradients.' : '——任务梯度相互影响的背景。'}</li>
              <li><a href="https://arxiv.org/abs/1512.03385">Deep Residual Learning</a> / <a href="https://arxiv.org/abs/2002.04745">On Layer Normalization in the Transformer Architecture</a>{en ? ' — background on residual connections and normalization.' : '——残差连接与归一化的背景。'}</li>
            </ul>
          </div>
          <a class="back-top" href="#top">{en ? 'Back to top ↑' : '回到顶部 ↑'}</a>
        </article>
      </main>
      <footer class="note-footer"><a href="/">← Yanlin Liu</a><span>{preview ? 'Notes / Draft' : 'Notes'}</span></footer>
    </div>
    <script>
      const headings = [...document.querySelectorAll<HTMLElement>('.note-body h2')];
      const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.section-index a')];
      const languageLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-language-link]')];
      let queued = false;
      const update = () => {
        const current = headings.filter(h => h.getBoundingClientRect().top <= 150).at(-1) ?? headings[0];
        tocLinks.forEach(link => { if (link.hash === `#${current.id}`) link.setAttribute('aria-current','location'); else link.removeAttribute('aria-current'); });
        languageLinks.forEach(link => { const url = new URL(link.href); url.hash = current.id; link.href = url.href; });
        queued = false;
      };
      window.addEventListener('scroll', () => {if (!queued) {queued = true; requestAnimationFrame(update);}}, {passive:true});
      update();
    </script>
  </body>
</html>
